APP_NAME="Credit HP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=credit_hp
DB_USERNAME=credit_hp_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# WHATSAPP GATEWAY (EVOLUTION API)
# Repo: https://github.com/evolution-foundation/evolution-api
# -----------------------------------------------------------------------------
WA_PROVIDER=evolution
WA_SENDER_NUMBER=
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_INSTANCE=credit-hp

# Automatic reminders: one H-1 notice and one due-date notice if still unpaid.
# Enable only after connecting the sender account to the gateway.
WA_REMINDERS_ENABLED=false
WA_REMINDER_TIME=09:00
WA_REMINDER_TIMEZONE=Asia/Jakarta
